{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "white": "#ffffff",
    "ink": "#4a4a4a",
    "g1": "#5f5f5f",
    "g2": "#6c6c6c",
    "g3": "#7a7a7a",
    "g4": "#858585",
    "g5": "#bcbcbc",
    "g6": "#e0e0e0",
    "g7": "#ffffff"
  },
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .UserName }} ",
          "foreground": "p:white",
          "background": "p:g1",
          "type": "session",
          "style": "diamond"
        },
        {
          "options": {
            "folder_separator_icon": "  ",
            "home_icon": "~",
            "style": "folder"
          },
          "template": "   {{ .Path }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g3",
          "type": "path",
          "style": "powerline"
        },
        {
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}"
          },
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "foreground": "p:ink",
          "powerline_symbol": "",
          "background": "p:g6",
          "type": "git",
          "style": "powerline",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:g7{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:g5{{ end }}",
            "{{ if gt .Ahead 0 }}p:g5{{ end }}",
            "{{ if gt .Behind 0 }}p:g5{{ end }}"
          ]
        },
        {
          "template": "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g2",
          "type": "node",
          "style": "powerline"
        },
        {
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g4",
          "type": "go",
          "style": "powerline"
        },
        {
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g2",
          "type": "julia",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g4",
          "type": "python",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files"
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g2",
          "type": "ruby",
          "style": "powerline"
        },
        {
          "options": {
            "display_mode": "files"
          },
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g4",
          "type": "azfunc",
          "style": "powerline"
        },
        {
          "options": {
            "display_default": false
          },
          "template": "  {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g2",
          "type": "aws",
          "style": "powerline"
        },
        {
          "template": "  ",
          "foreground": "p:ink",
          "powerline_symbol": "",
          "background": "p:g7",
          "type": "root",
          "style": "powerline"
        },
        {
          "options": {
            "always_enabled": true
          },
          "template": "<transparent></>  {{ .FormattedMs }}⠀",
          "foreground": "p:white",
          "background": "p:g3",
          "type": "executiontime",
          "style": "diamond",
          "trailing_diamond": ""
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "template": "<p:g2,transparent></>  {{ .Name }} <transparent,p:g2></>",
          "foreground": "p:white",
          "background": "p:g2",
          "type": "shell",
          "style": "plain"
        },
        {
          "options": {
            "paused_icon": " ",
            "playing_icon": " "
          },
          "template": "  {{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Artist }} - {{ .Track }}{{ end }} ",
          "foreground": "p:ink",
          "powerline_symbol": "",
          "background": "p:g6",
          "type": "ytm",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "options": {
            "charged_icon": " ",
            "charging_icon": " ",
            "discharging_icon": " "
          },
          "template": " {{ if not .Error }}{{ .Icon }}{{ .Percentage }}{{ end }}{{ .Error }} ",
          "foreground": "p:white",
          "powerline_symbol": "",
          "background": "p:g4",
          "type": "battery",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "leading_diamond": "",
          "trailing_diamond": "",
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "p:ink",
          "background": "p:g6",
          "type": "time",
          "style": "diamond",
          "invert_powerline": true
        }
      ]
    }
  ],
  "version": 4,
  "final_space": true
}
